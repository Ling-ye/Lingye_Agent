# Lingye Agent environment template
# Copy this file to .env and replace only the values you need.
# Never commit .env or real credentials.

# ----------------------------------------------------------------------
# LLM: configure at least one OpenAI-compatible endpoint
# ----------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL_ID=your-model-id
LLM_TIMEOUT=180

SUPPORTED_PROVIDERS=openai,aihubmix,deepseek,qwen,modelscope,kimi,zhipu,ollama,vllm,local

OPENAI_API_KEY=
AIHUBMIX_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MODELSCOPE_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
GLM_API_KEY=

OLLAMA_API_KEY=
OLLAMA_HOST=http://localhost:11434
VLLM_API_KEY=
VLLM_HOST=http://localhost:8000

DEBUG=false
LOG_LEVEL=INFO
TEMPERATURE=0.7
MAX_TOKENS=1024

# ----------------------------------------------------------------------
# Qdrant: optional vector storage for RAG and semantic memory
# ----------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=lingye_memory_384
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30
QDRANT_HTTP_TRUST_ENV=0
RAG_QDRANT_COLLECTION=lingye_rag_384

# ----------------------------------------------------------------------
# Neo4j: optional graph storage
# ----------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=300
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# ----------------------------------------------------------------------
# Embeddings
# Local offline mode requires an existing model directory.
# Example: /path/to/all-MiniLM-L6-v2
# ----------------------------------------------------------------------
EMBED_MODEL_TYPE=local
EMBED_MODEL_NAME=/path/to/all-MiniLM-L6-v2
EMBED_OFFLINE=1
EMBED_STRICT_LOCAL=1
EMBED_API_KEY=
EMBED_BASE_URL=

# Hosted DashScope example:
# EMBED_MODEL_TYPE=dashscope
# EMBED_MODEL_NAME=text-embedding-v3
# EMBED_API_KEY=
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# QDRANT_VECTOR_SIZE=1024
# QDRANT_COLLECTION=lingye_memory_1024
# RAG_QDRANT_COLLECTION=lingye_rag_1024

# ----------------------------------------------------------------------
# Optional tools and MCP servers
# ----------------------------------------------------------------------
TAVILY_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
